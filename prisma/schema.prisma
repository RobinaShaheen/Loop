generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  company       String
  feedbackCount Int       @default(0)
  sentiment     String    @default("Neutral")
  score         Int       @default(0)
  lastFeedback  String?
  status        String    @default("Active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  feedback      Feedback[]
}

model Feedback {
  id           Int      @id @default(autoincrement())
  customerId   Int?
  customerName String
  email        String
  message      String
  sentiment    String
  category     String
  priority     String
  date         String
  createdAt    DateTime @default(now())
  customer     Customer? @relation(fields: [customerId], references: [id])
}

model Insight {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  confidence  Int
  category    String
  createdAt   DateTime @default(now())
}

model Theme {
  id           Int      @id @default(autoincrement())
  name         String
  percentage   Int
  feedbackCount Int     @default(0)
  createdAt    DateTime @default(now())
}

model Recommendation {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  priority    String
  applied     Boolean  @default(false)
  createdAt   DateTime @default(now())
}
